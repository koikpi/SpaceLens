#!/bin/bash

set -u

APP_DIR="$(cd "$(dirname "$0")" && pwd)"
ADDRESS="http://127.0.0.1:8765"

# Finder-launched apps do not always let a background Python thread activate
# the default browser. Wait for the local service, then use Launch Services.
(
    for _ in {1..80}; do
        if /usr/bin/curl --silent --fail --max-time 1 "$ADDRESS/" >/dev/null 2>&1; then
            /usr/bin/open "$ADDRESS" >/dev/null 2>&1
            exit 0
        fi
        /bin/sleep 0.25
    done
) &

exec "$APP_DIR/SpaceLens-bin" --no-browser
